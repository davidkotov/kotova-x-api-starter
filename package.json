{
  "name": "kotova-x-api-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Example integration and starter app for the Kotova X public API (Next.js, TypeScript).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3020",
    "build": "next build",
    "start": "next start --port 3020",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/api-types.mjs",
    "check:api": "node scripts/api-types.mjs --check"
  },
  "dependencies": {
    "next": "14.2.35",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  }
}
