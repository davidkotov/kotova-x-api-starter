# Copy to .env.local and fill in. All of these are read on the server only:
# never prefix them with NEXT_PUBLIC_, so they never reach the browser.
# README.md, "Configuration" and "Before you deploy", explains each one.

# Your secret API key (ktv_sk_...). Create one at https://app.kotova.io/account/api
KOTOVA_API_KEY=

# Signs the cookie that lists the orders created in a browser: the app opens
# an order only for the browser that created it. Required in production, at
# least 32 characters, for example the output of: openssl rand -hex 32
# Without it, development uses a random one until the dev server stops.
APP_SESSION_SECRET=

# Optional. The API base URL; leave unset for production. Must be https://
# (plain http:// is accepted only for localhost).
# KOTOVA_API_BASE=https://api.kotova.io/x/v1

# Optional. The origin(s) allowed to POST to /api/kx (comma-separated). Set it
# when your proxy or host rewrites the Host header.
# APP_ORIGIN=https://swap.example.com

# ---- End-user IP (end_user_ip on POST /quote) -------------------------------
# Some sources need the visitor's IP; without it they are skipped. No header is
# trusted by default. Name the one your host sets, and/or the number of proxies
# in front of the app that append to X-Forwarded-For. With neither, no IP is sent.

# A header your host sets (or overwrites) to the visitor's IP, one address:
# x-vercel-forwarded-for (Vercel), cf-connecting-ip (Cloudflare), fly-client-ip
# (Fly.io), x-real-ip (your nginx sets it from $remote_addr).
# KOTOVA_END_USER_IP_HEADER=x-vercel-forwarded-for

# N proxies in front of the app, each appending to X-Forwarded-For: the visitor
# is the N-th entry from the right. Only when the app cannot be reached directly.
# TRUSTED_PROXY_HOPS=1

# Development only (ignored when NODE_ENV=production): a public IP to send when
# no trusted one is found, so sources that need it can be tried from your
# machine. Use your own public IP.
# KOTOVA_DEV_END_USER_IP=
